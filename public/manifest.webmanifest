{
  "name": "ANNPURNN — Share Food, Share Dignity",
  "short_name": "ANNPURNN",
  "description": "Community food-sharing for Surat. अन्न ब्रह्म है — food is divine. Request or donate food, always free, with dignity and privacy.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fffdf5",
  "theme_color": "#1b5e20",
  "icons": [
    { "src": "/img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/img/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/img/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Request Food", "url": "/#/request/new", "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192" }] },
    { "name": "Donate Food", "url": "/#/donate/new", "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192" }] },
    { "name": "Community Requests", "url": "/#/requests", "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192" }] }
  ]
}
